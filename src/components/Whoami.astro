---
import '@fontsource/anton';
import '@fontsource/roboto-mono';
import '@fontsource/cormorant-garamond';
import {ArrowUpRight} from '@lucide/astro';

---

<section id="whoami" class="bg-[#F5F3ED] dark:bg-[#0F172A] min-h-[600px] font-['Roboto_Mono'] text-neutral-900 dark:text-[#F5F3ED] border-b border-neutral-300">
    <div class="mx-6 sm:mx-12 py-16 sm:py-20 flex flex-col justify-between h-full">
        <!-- 區塊編號與標題 -->
        <div class="flex justify-between items-center text-xs uppercase tracking-widest text-neutral-500 mb-10">
            <span data-top class="invisible">01 / Whoami</span>
            <span data-top class="invisible">TAIWAN — CS & SECURITY</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            <!-- 左側 -->
            <div class="lg:col-span-6 space-y-6">
                <h1 data-title class="invisible text-5xl sm:text-7xl tracking-tight font-['Anton'] uppercase leading-none">
                    Hi, I'm DaoHui.
                </h1>
                <p data-intro class="invisible text-base sm:text-lg text-neutral-700 max-w-lg font-['Cormorant_Garamond'] italic leading-relaxed">
                    A passionate high school security enthusiast and developer exploring the depths of binary analysis, cybersecurity challenges, and hardware-software integration.
                </p>
                <div data-cta class="invisible pt-2">
                    <a href="/about" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider border-b border-black pb-1 hover:opacity-75 transition-opacity ">
                        Explore More About Me <span data-arrow class="inline-block"><ArrowUpRight width={12} height={12} /></span>
                    </a>
                </div>
            </div>

            <!-- 右側 -->
            <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-8 pt-2">
                <div data-card class="invisible space-y-2 border-l-2 border-neutral-300 pl-4">
                    <span class="block font-bold text-xs uppercase tracking-wider text-neutral-400">Security</span>
                    <h3 class="font-bold text-lg">CTF Competitor</h3>
                    <p class="text-xs text-neutral-600 leading-normal">
                        Active participant in capture-the-flag competitions, tackling web, crypto, and binary challenges.
                    </p>
                </div>

                <div data-card class="invisible space-y-2 border-l-2 border-neutral-300 pl-4">
                    <span class="block font-bold text-xs uppercase tracking-wider text-neutral-400">Research</span>
                    <h3 class="font-bold text-lg">Cybersecurity Researcher</h3>
                    <p class="text-xs text-neutral-600 leading-normal">
                        Focusing on penetration testing, reverse engineering, and AI/hardware security intersections.
                    </p>
                </div>

                <div data-card class="invisible space-y-2 border-l-2 border-neutral-300 pl-4">
                    <span class="block font-bold text-xs uppercase tracking-wider text-neutral-400">Development</span>
                    <h3 class="font-bold text-lg">System & Automation</h3>
                    <p class="text-xs text-neutral-600 leading-normal">
                        Building tools with Python, managing Linux environments, and developing custom script architectures.
                    </p>
                </div>

                <div data-card class="invisible space-y-2 border-l-2 border-neutral-300 pl-4">
                    <span class="block font-bold text-xs uppercase tracking-wider text-neutral-400">Hardware</span>
                    <h3 class="font-bold text-lg">Hardware Security</h3>
                    <p class="text-xs text-neutral-600 leading-normal">
                        Exploring FPGA acceleration security risks, logic design, and side-channel analysis concepts.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from 'gsap';

    function initWhoami() {
        const root = document.querySelector<HTMLElement>('#whoami');
        if (!root) return;

        const q = <T extends Element = HTMLElement>(sel: string) =>
            Array.from(root.querySelectorAll<T>(sel));

        const title = root.querySelector<HTMLElement>('[data-title]')!;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 減少動態偏好:直接顯示,不播放動畫
        if (reduce) {
            gsap.set(root.querySelectorAll('.invisible'), { autoAlpha: 1 });
            return;
        }

        // 把標題拆成逐字,外層 overflow-hidden 做遮罩上滑效果
        const text = title.textContent!.trim();
        title.setAttribute('aria-label', text);
        title.textContent = '';
        text.split('').forEach((ch) => {
            const mask = document.createElement('span');
            mask.className = 'inline-block overflow-hidden align-bottom';
            mask.setAttribute('aria-hidden', 'true');
            const inner = document.createElement('span');
            inner.className = 'inline-block char';
            inner.textContent = ch === ' ' ? '\u00A0' : ch;
            mask.appendChild(inner);
            title.appendChild(mask);
        });

        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

        tl.set(title, { autoAlpha: 1 })
          .from(title.querySelectorAll('.char'), {
              yPercent: 110,
              duration: 0.8,
              stagger: 0.04,
          })
          .to(q('[data-top]'), { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.1 }, 0)
          .fromTo(q('[data-intro]'), { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.7 }, '-=0.4')
          .fromTo(q('[data-cta]'), { autoAlpha: 0, y: 15 }, { autoAlpha: 1, y: 0, duration: 0.5 }, '-=0.3')
          .fromTo(
              q('[data-card]'),
              { autoAlpha: 0, x: 30 },
              { autoAlpha: 1, x: 0, duration: 0.6, stagger: 0.12 },
              '-=0.8'
          );

        // 箭頭 hover 動畫
        const cta = root.querySelector<HTMLAnchorElement>('[data-cta] a');
        const arrow = root.querySelector('[data-arrow]');
        cta?.addEventListener('mouseenter', () =>
            gsap.to(arrow, { x: 4, y: -4, duration: 0.25, ease: 'power2.out' }));
        cta?.addEventListener('mouseleave', () =>
            gsap.to(arrow, { x: 0, y: 0, duration: 0.25, ease: 'power2.out' }));

        // 卡片左邊框 hover 變深
        q('[data-card]').forEach((card) => {
            card.addEventListener('mouseenter', () =>
                gsap.to(card, { borderColor: '#171717', x: 4, duration: 0.25 }));
            card.addEventListener('mouseleave', () =>
                gsap.to(card, { borderColor: '#d4d4d4', x: 0, duration: 0.25 }));
        });
    }

    initWhoami();
    // 如果你的網站有用 <ClientRouter /> (View Transitions),換頁後要重跑:
    document.addEventListener('astro:page-load', initWhoami);
</script>   