---
// src/components/PasswordGate.astro
interface Props {
    hash?: string; // 密碼的 SHA-256（十六進位）
}

const { hash } = Astro.props;
---

{
    hash ? (
        <>
            <form
                id="gate"
                data-hash={hash.toLowerCase()}
                class="max-w-[42rem] border-t-2 border-neutral-900 pt-5 font-['Roboto_Mono',monospace]"
            >
                <label
                    for="gate-input"
                    class="block text-sm font-bold text-neutral-900"
                >
                    這篇文章需要密碼
                </label>
                <div class="mt-4 flex items-end gap-3">
                    <input
                        id="gate-input"
                        type="password"
                        autocomplete="off"
                        required
                        class="w-full max-w-[280px] border-b border-black/80 bg-transparent py-2 text-sm focus:border-[#6600FF] focus:outline-none"
                    />
                    <button
                        type="submit"
                        class="cursor-pointer bg-[#6600FF] px-4 py-2 text-xs font-bold text-white hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6600FF]"
                    >
                        解鎖
                    </button>
                </div>

                {/* 錯誤 / 弱密碼警告 Alert */}
                <div 
                    id="gate-error" 
                    role="alert" 
                    class="relative mt-6 w-full rounded-lg border border-red-500/50 p-4 text-red-600 dark:border-red-500 [&>svg~*]:pl-7 [&>svg+div]:translate-y-[-1px] [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg]:text-red-600 dark:[&>svg]:text-red-500"
                    hidden
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                    >
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" x2="12" y1="8" y2="12" />
                        <line x1="12" x2="12.01" y1="16" y2="16" />
                    </svg>
                    <div>
                        <h5 id="error-title" class="mb-1 font-medium leading-none tracking-tight text-sm">
                            密碼錯誤
                        </h5>
                        <div id="error-desc" class="text-sm opacity-90 [&_p]:leading-relaxed">
                            請重新確認後再試一次。
                        </div>
                    </div>
                </div>
            </form>

            <div id="protected" hidden>
                <slot />
            </div>
        </>
    ) : (
        <slot />
    )
}

<script>
    const gate = document.getElementById("gate") as HTMLFormElement | null;

    if (gate) {
        const content = document.getElementById("protected")!;
        const error = document.getElementById("gate-error")!;
        const errorTitle = document.getElementById("error-title")!;
        const errorDesc = document.getElementById("error-desc")!;
        const input = document.getElementById("gate-input") as HTMLInputElement;
        const hash = gate.dataset.hash ?? "";
        const storeKey = `unlocked:${location.pathname}:${hash}`;

        const sha256 = async (text: string) => {
            const buf = await crypto.subtle.digest(
                "SHA-256",
                new TextEncoder().encode(text),
            );
            return Array.from(new Uint8Array(buf))
                .map((b) => b.toString(16).padStart(2, "0"))
                .join("");
        };

        const unlock = () => {
            content.hidden = false;
            gate.remove();
        };

        // 同一個分頁解鎖過就不用再輸入
        try {
            if (sessionStorage.getItem(storeKey) === "1") unlock();
        } catch {}

        gate.addEventListener("submit", async (e) => {
            e.preventDefault();
            const val = input.value;
            const inputHash = await sha256(val);

            // 檢查是否輸入了弱密碼 admin123 (其 SHA-256 雜湊為 240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9)
            if (inputHash === "240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9") {
                errorTitle.textContent = "嘿嘿你幹嘛用弱密碼想必你也知道這是不安全的";
                errorDesc.textContent = "daohui{p455wd_h45_w34k_c4n_n07_1061n_d45hb04rd}";
                error.hidden = false;
                input.select();
                return;
            }

            if (inputHash === hash) {
                try {
                    sessionStorage.setItem(storeKey, "1");
                } catch {}
                unlock();
            } else {
                errorTitle.textContent = "密碼錯誤";
                errorDesc.textContent = "請重新確認後再試一次。";
                error.hidden = false;
                input.select();
            }
        });
    }
</script>