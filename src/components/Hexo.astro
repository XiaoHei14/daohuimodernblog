---
import Header from './Header.astro';
import ChodanPostCard from '../assets/chodanpostcard.jpeg';
import ChodanMainView from '../assets/Chodanmain2.png';
import {ArrowUpRight} from '@lucide/astro';
import '@fontsource/anton'
import '@fontsource/roboto-mono'
import '@fontsource/cormorant-garamond'
---

<body class="bg-[#DDF1FF] dark:bg-[#09090B] dark:text-[#F5F3ED] min-h-screen flex flex-col justify-between overflow-x-hidden text-black font-['roboto_mono']">
    <Header />
    
    <!-- 主要內容區塊 -->
    <main class="w-full h-screen max-w-7xl mx-auto px-6 lg:px-12 py-6 flex-1 flex flex-col justify-between">
        
        <!-- 上方小標題 -->
        <div class="text-[10px] tracking-wider text-gray-800 dark:text-[#F5F3ED] font-semibold mb-4">
            PERSONAL COLLECTION / VOL. 01
        </div>

        <!-- 中間主內容：雙欄佈局 (左側文字、右側圖片) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative my-auto">
            
            <!-- 左側文字區塊 -->
            <div class="lg:col-span-7 flex flex-col justify-center z-10">
                <h1 class="text-[132px] font-['anton'] sm:text-6xl lg:text-7xl font-regular tracking-tight leading-[0.95] mb-8 uppercase">
                    A LITTLE STYLE. <br/>
                    A LITTLE LIFE.
                </h1>
                
                <p class="text-sm sm:text-base text-gray-800 dark:text-[#F5F3ED] max-w-md mb-8 leading-relaxed">
                    A personal edit of what catches the eye — and what stays with you.
                </p>

                <div>
                    <a href="#" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider border-b border-black pb-1 hover:opacity-75 transition-opacity">
                        Explore the Journal <span><ArrowUpRight width={12} height={12} /></span>
                    </a>
                </div>
            </div>

            <!-- 右側主視覺與拍立得卡片區塊 -->
            <div class="lg:col-span-5 relative flex justify-center lg:justify-end items-center">
                <!-- 右上角手寫裝飾字 (模擬圖中的 Hello, Chodan.) -->
                <div class="absolute -top-10 right-10 lg:right-20 text-[#6600FF] italic font-['cormorant-garamond'] text-lg z-20 pointer-events-none hidden sm:block">
                    Hello, Chodan.
                    <span class="block text-sm">↓</span>
                </div>

                <!-- 主視覺背景裝飾圓與圖片容器 -->
                <div class="relative w-full max-w-[440px] aspect-square flex items-center justify-center">
                    <!-- 底部的圓形/半圓形裝飾背板 (淺色柔和圓圈) -->
                    <div class="absolute inset-0 bg-white/40 dark:bg-[#0F172A] rounded-full scale-95 z-0"></div>

                    <!-- 主視覺人物圖片 -->
                    <img
                        src={ChodanMainView.src}
                        alt="Chodan main portrait"
                        class="relative z-10 w-full h-full object-contain object-bottom"
                    />

                    <!-- 拍立得風格卡片 (定位在左下角壓著主視覺) -->
                    <article class="w-[150px] -rotate-6 bg-white p-2 shadow-2xl duration-300 z-30 absolute -bottom-6 -left-4 sm:left-4">
                        <!-- 卡片頂部標題列 -->
                        <div class="mb-2 flex items-center justify-between px-1 text-[9px] font-bold text-[#6600FF]">
                            <span>ANOTHER SIDE</span>
                            <span aria-hidden="true"><ArrowUpRight width={12} height={12} /></span>
                        </div>

                        <!-- 拍立得照片 -->
                        <div class="h-[160px] w-full overflow-hidden bg-gray-200">
                            <img
                                src={ChodanPostCard.src}
                                alt="Chodan"
                                class="h-full w-full object-cover"
                            />
                        </div>
                    </article>
                </div>
            </div>
        </div>

        <!-- 底部標語與滾動提示 -->
        <div class="flex flex-col sm:flex-row justify-between items-center text-[10px] tracking-wider text-gray-800 dark:text-[#F5F3ED] mt-8 pt-4 border-t border-transparent">
            <span>NOT A CATALOGUE. A POINT OF VIEW.</span>
            <span>SCROLL TO DISCOVER ↓</span>
        </div>
    </main>
</body>