---
import '@fontsource/anton'
import '@fontsource/roboto-mono'
import { Menu, X,ArrowUpRight } from '@lucide/astro'

import ChodanPostCard from '../assets/chodan2.jpeg'
import ChodanMainView from '../assets/Chodanmain2.png'

const menuItems = [
    { number: '01', label: 'HOME', href: '/' },
    { number: '02', label: 'ABOUT', href: '/about' },
    { number: '03', label: 'BLOG', href: '/blog' },
    { number: '04', label: 'FRIEND', href: '/friend' },
]
---

<!-- 開啟按鈕（放在 Header 裡的位置） -->
<button id="menu-open" type="button" aria-label="Open menu" aria-expanded="false" class="cursor-pointer">
    <Menu />
</button>

<!-- 覆蓋層：原本的 <body> 換成這個 div，其餘內容完全沿用你的 -->
<div
    id="menu-overlay"
    class="invisible fixed inset-0 z-50 min-h-screen overflow-y-auto overflow-x-hidden bg-[#B9E4FF] text-[#09090B] opacity-0 transition-opacity duration-300 data-[open=true]:visible data-[open=true]:opacity-100"
>
    <!-- 關閉按鈕（唯一新增的元素，位置可自行調整） -->
    <button
        id="menu-close"
        type="button"
        aria-label="Close menu"
        class="fixed right-6 top-[24px] z-50 cursor-pointer md:right-12 md:top-[32px]"
    >
        <X />
    </button>

    <div class="min-h-screen flex flex-col">

        <!-- Header -->
        <header class="flex h-[72px] shrink-0 items-center justify-between px-6 md:h-[88px] md:px-12">
            <a href="/" class="font-['anton'] text-[20px] leading-none md:text-[24px]">
                HAMBURGER MENU
            </a>

        </header>

        <!-- Main -->
        <main class="flex-1 px-6 md:px-12 flex items-center">
            <div class="mx-auto w-full max-w-[1600px] grid grid-cols-1 lg:grid-cols-[minmax(240px,0.8fr)_minmax(420px,1.4fr)_minmax(380px,1fr)] items-center gap-12 lg:gap-16 min-h-[calc(100vh-160px)]">

                <!-- 1. Left Column: Intro & Polaroid -->
                <section class="relative z-20 flex flex-col items-start gap-12">
                    <div class="grid w-[172px] gap-2 font-['roboto-mono'] text-left">
                        <span class="text-[32px] font-light leading-none md:text-[40px]">Chodan</span>
                        <div class="text-[11px] leading-[1.6]">
                            <p>A LITTLE STYLE.</p>
                            <p>A LITTLE LIFE.</p>
                        </div>
                        <div class="mt-1 h-[2px] w-6 bg-[#6600FF]"></div>
                    </div>

                    <article class="w-[150px] rotate-[-4deg] bg-white p-2 shadow-lg transition-transform z-20">
                        <div class="mb-2 flex items-center justify-between px-1 font-['roboto_mono'] text-[9px] text-[#6600FF] font-bold">
                            <span>ANOTHER SIDE</span>
                            <span><ArrowUpRight width={12} height={12} /></span>
                        </div>
                        <div class="h-[168px] w-full overflow-hidden bg-gray-200">
                            <img src={ChodanPostCard.src} alt="Chodan" class="h-full w-full object-cover" />
                        </div>
                    </article>

                    <section class="lg:hidden block absolute h-[400px] w-full overflow-hidden lg:h-[min(72vh,720px)] lg:min-h-[520px]">
                        <img src={ChodanMainView.src} alt="Chodan main portrait" class="h-full w-full object-cover object-center" />
                        <div class="absolute bottom-5 left-5 font-['roboto_mono'] text-[9px] text-white mix-blend-difference">
                            PERSONAL / 01
                        </div>
                    </section>
                </section>

                <!-- 2. Middle Column: Main Image -->
                <section class="lg:block hidden relative h-[450px] w-full overflow-hidden lg:h-[min(72vh,720px)] lg:min-h-[520px]">
                    <img src={ChodanMainView.src} alt="Chodan main portrait" class="h-full w-full object-cover object-center" />
                    <div class="absolute bottom-5 left-5 font-['roboto_mono'] text-[9px] text-white mix-blend-difference">
                        PERSONAL / 01
                    </div>
                </section>

                <!-- 3. Right Column: Navigation -->
                <section class="relative flex w-full pt-4 flex-col justify-center">
                    <div class="mb-4 flex w-full justify-between font-['roboto_mono'] text-[9px] text-gray-500 md:text-[10px]">
                        <span>EXPLORE THE EDIT</span>
                        <span class="text-[#6600FF]">01 / SELECTED</span>
                    </div>

                    <nav aria-label="Main navigation" class="flex flex-col gap-2">
                        {
                            menuItems.map((item, index) => (
                                <a
                                    href={item.href}
                                    class={`
                                        menu-link
                                        group flex w-full items-center justify-between px-5 py-1
                                        transition-all duration-200
                                        hover:bg-[#6600FF] hover:text-white
                                        ${index % 2 === 0 ? 'rotate-[-2deg]' : 'rotate-[1deg]'}
                                    `}
                                >
                                    <div class="flex items-center gap-5">
                                        <span class="font-['roboto_mono'] text-[10px] text-gray-500 transition-colors group-hover:text-white">
                                            {item.number}
                                        </span>
                                        <span class="font-['Anton'] text-[34px] leading-[1.1] tracking-wide md:text-[40px]">
                                            {item.label}
                                        </span>
                                    </div>
                                    <span class="translate-x-[-4px] text-[20px] opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100">
                                        →
                                    </span>
                                </a>
                            ))
                        }
                    </nav>

                    <p class="mt-5 w-full font-['roboto_mono'] text-[9px] leading-[1.6] text-gray-600">
                        A curated collection of everyday favorites.
                    </p>
                </section>
            </div>
        </main>

        <!-- Footer -->
        <footer class="mb-[30px] flex min-h-[42px] shrink-0 flex-col items-center justify-center gap-1 border-t border-black/80 font-['roboto_mono'] text-[8px] pt-4 md:mx-12 md:flex-row md:justify-between md:text-[9px]">
            <span>PERSONAL COLLECTION / VOL. 01</span>
            <span>GOOD THINGS, IN GOOD COMPANY.</span>
        </footer>

    </div>
</div>

<script>
    const openBtn = document.getElementById('menu-open')
    const closeBtn = document.getElementById('menu-close')
    const overlay = document.getElementById('menu-overlay')

    function setMenu(open: boolean) {
        if (!overlay || !openBtn) return
        overlay.dataset.open = String(open)
        openBtn.setAttribute('aria-expanded', String(open))
        document.body.style.overflow = open ? 'hidden' : ''
    }

    openBtn?.addEventListener('click', () => setMenu(true))
    closeBtn?.addEventListener('click', () => setMenu(false))
    overlay?.querySelectorAll('.menu-link').forEach((link) =>
        link.addEventListener('click', () => setMenu(false))
    )
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false)
    })
</script>