---
// src/components/CustomComments.astro
export interface Props {
  issueNumber: number; // 這篇文章對應的 GitHub Issue 編號
}

const { issueNumber } = Astro.props;
const repo = "你的GitHub帳號/你的倉庫名稱";
---

<div class="max-w-[720px] mx-auto px-6 w-full my-16 font-['Roboto_Mono',monospace]">
  <div class="border-t border-black/15 pt-10">
    <h3 class="text-xl font-extrabold uppercase tracking-wider mb-6 flex items-center justify-between">
      <span>// Discussions & Comments</span>
      <span class="text-xs text-neutral-400 font-normal">Powered by GitHub Issues</span>
    </h3>

    <!-- 留言列表區塊 -->
    <div id="comments-list" class="space-y-4 mb-8">
      <div class="p-4 border border-black/15 bg-white text-neutral-500 text-sm animate-pulse rounded-lg">
        Loading comments from GitHub...
      </div>
    </div>

    <!-- 前往 GitHub 留言的引導按鈕 (最安全且不需要複雜登入的好方法) -->
    <div class="p-6 border border-black/20 bg-neutral-100 rounded-xl text-center">
      <p class="text-xs text-neutral-600 mb-4 uppercase tracking-wider">
        Want to join the conversation? Leave a comment on GitHub!
      </p>
      <a
        id="github-comment-btn"
        href={`https://github.com/${repo}/issues/${issueNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#6600FF] text-white px-6 py-3 text-xs font-bold uppercase tracking-wider rounded-lg shadow-md hover:opacity-90 transition-opacity"
      >
        <span>Comment on GitHub</span>
        <span>→</span>
      </a>
    </div>
  </div>
</div>

<script define:vars={{ issueNumber, repo }}>
  async function fetchComments() {
    const container = document.getElementById('comments-list');
    if (!container) return;

    try {
      // 呼叫 GitHub Public REST API 抓取 Issue 的留言 (Comments)
      const response = await fetch(`https://api.github.com/repos/${repo}/issues/${issueNumber}/comments`);
      if (!response.ok) throw new Error('Failed to fetch comments');
      
      const comments = await response.json();

      if (comments.length === 0) {
        container.innerHTML = `
          <div class="p-6 border border-black/15 bg-white text-neutral-500 text-xs text-center rounded-lg">
            No comments yet. Be the first to start the conversation!
          </div>
        `;
        return;
      }

      // 渲染留言清單，完美對應你的部落格工業風設計
      container.innerHTML = comments.map(comment => {
        const date = new Date(comment.created_at).toLocaleDateString('zh-TW', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        });

        return `
          <div class="p-5 border border-black/20 bg-white rounded-xl shadow-xs space-y-3">
            <div class="flex items-center justify-between text-xs border-b border-black/10 pb-3">
              <div class="flex items-center gap-2">
                <img src="${comment.user.avatar_url}" alt="${comment.user.login}" class="w-6 h-6 rounded-full border border-black/20" />
                <a href="${comment.user.html_url}" target="_blank" rel="noopener" class="font-bold text-neutral-900 hover:text-[#6600FF] transition-colors">
                  @${comment.user.login}
                </a>
              </div>
              <span class="text-neutral-400">${date}</span>
            </div>
            <div class="text-sm text-neutral-800 leading-relaxed prose-sm">
              ${escapeHtml(comment.body)}
            </div>
          </div>
        `;
      }).join('');

    } catch (error) {
      container.innerHTML = `
        <div class="p-4 border border-red-200 bg-red-50 text-red-600 text-xs rounded-lg">
          Unable to load comments at this moment.
        </div>
      `;
    }
  }

  // 簡單防範 XSS 的跳脫字元函式
  function escapeHtml(text) {
    return text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;")
      .replace(/\n/g, "<br>"); // 支援簡單換行
  }

  fetchComments();
</script>