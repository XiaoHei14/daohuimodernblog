---
import type { ImageMetadata } from 'astro';
import {ArrowUpRight} from '@lucide/astro';
interface Props {
    image: ImageMetadata; // 建議屬性名稱改為小寫以符合慣例
}

const { image } = Astro.props;
---

<article
    class="w-[150px] bg-white p-2 shadow-lg "
>
    <!-- 卡片頂部標題列 -->
    <div
        class="mb-2 flex items-center justify-between px-1 font-['roboto_mono'] text-[9px] text-[#6600FF] font-bold"
    >
        <span>ANOTHER SIDE</span>
        <span aria-hidden="true"><ArrowUpRight width={12} height={12} /></span>
    </div>

    <!-- 圖片容器 -->
    <div class="h-[168px] w-full overflow-hidden bg-gray-200">
        <img
            src={image.src}
            alt="Chodan Polaroid"
            class="h-full w-full object-cover"
        />
    </div>
</article>