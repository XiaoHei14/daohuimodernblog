---
// src/layouts/BlogPost.astro  —  Magazine / feature-article layout
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import AuthorByline from "../components/AuthorByline.astro";
import PasswordGate from "../components/PasswordGate.astro";
import FriendPolaroidCard from "../components/FriendPolaroidCard.astro";
import { getCollection } from "astro:content";
import Giscus from "../components/Giscus.astro";
import "@fontsource/anton";
import "@fontsource/roboto-mono";
import '@fontsource/cormorant-garamond';
import "../styles/article-body.css";

const {
    title,
    description,
    author,
    pubDate,
    updatedDate,
    heroImage,
    heroCaption, // 選填：封面圖說明文字
    tags,
    minutesRead,
    passwordHash, // 選填：文章密碼的 SHA-256
    Content,
} = Astro.props;

const authorList = Array.isArray(author) ? author : author ? [author] : [];
const tagList = Array.isArray(tags) ? tags : tags ? [tags] : [];

// 讀取 friends collection，給 [@xxx](friend:xxx) 用
const friends = await getCollection("friend");
const friendCards = friends.map((f) => ({
    id: f.id.replace(/\.(md|mdx)$/, ""),
    ...f.data,
}));
---

<html lang="zh-Hant" class="scroll-smooth">
    <head>
        <BaseHead title={title} description={description} />
        <script is:inline>
            // 防閃爍腳本
            if (
                localStorage.theme === 'dark' ||
                (!('theme' in localStorage) &&
                    window.matchMedia('(prefers-color-scheme: dark)').matches)
            ) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        </script>
        <style is:global>
            :root {
                --ink: #171717;
                --bg: #fafafa;
                --accent: #6600ff;
                --serif:
                    "Noto Serif TC", "Source Han Serif TC", "Songti TC",
                    "PMingLiU", Georgia, serif;
                --sans-heavy:
                    "Noto Sans TC", "PingFang TC", "Microsoft JhengHei",
                    system-ui, sans-serif;
            }

            /* ---------- 深色模式 ---------- */
            .dark {
                --ink: #f5f5f5;
                --bg: #0a0a0a;
            }

            /* ---------- 標題 ---------- */
            .headline {
                font-family: "Anton", var(--sans-heavy);
                font-weight: 900;
                font-synthesis: none;
                font-size: clamp(2rem, 8vw, 7rem);
                line-height: 1.04;
                letter-spacing: -0.01em;
                text-transform: uppercase;
                text-wrap: balance;
                color: var(--ink);
                margin: 0;
                word-break: break-word;
            }

            /* ---------- 前言 (standfirst) ---------- */
            .standfirst {
                font-family: var(--serif);
                font-size: 1.25rem;
                line-height: 1.75;
                color: var(--ink);
                border-top: 2px solid var(--ink);
                padding-top: 1rem;
                margin: 0;
            }

            @media (max-width: 640px) {
                .standfirst {
                    font-size: 1.125rem;
                }
            }
        </style>
    </head>

    <body
        class="bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100 antialiased selection:bg-[#6600FF] selection:text-white overflow-x-hidden transition-colors duration-200"
    >
        <!-- 導航列 + 期刊資訊列 -->
        <div class="px-4 md:px-12 pt-6 font-['Roboto_Mono',monospace]">
            <Header />

            <nav
                class="max-w-[1280px] mx-auto mt-6 md:mt-8 flex flex-wrap items-center justify-between gap-4 border-b border-black dark:border-white pb-3 text-xs"
                aria-label="Article Navigation"
            >
                <button
                    type="button"
                    id="back-btn-top"
                    class="group inline-flex items-center gap-2 font-bold text-[#6600FF] dark:text-[#be9eff] transition-opacity hover:opacity-80 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6600FF]"
                >
                    <span class="transition-transform group-hover:-translate-x-1"
                        >←</span
                    > Back to list
                </button>
                <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-100 flex-wrap">
                    <FormattedDate date={pubDate} />
                    {
                        updatedDate && (
                            <span class="italic text-neutral-500 dark:text-neutral-100">
                                (Updated: <FormattedDate date={updatedDate} />)
                            </span>
                        )
                    }
                </div>
            </nav>
        </div>

        <!-- 主內容區 -->
        <main class="fade-in opacity-0">
            <article
                id="top"
                class="mx-auto max-w-[1280px] px-4 pb-16 pt-8 md:px-12 md:pt-16"
            >
                <!-- 開場：超大標題 -->
                <header>
                    <h1 class="headline">{title}</h1>
                </header>

                <!-- 開場：前言 + 封面圖（桌機 4 / 8 欄） -->
                <div
                    class="mt-8 grid gap-8 md:mt-12 lg:grid-cols-12 lg:gap-x-12"
                >
                    <div
                        class={heroImage
                            ? "lg:col-span-4"
                            : "lg:col-span-8 lg:col-start-5"}
                    >
                        {description && <p class="font-['cormorant_garamond'] italic text-lg md:text-xl text-neutral-800 dark:text-neutral-100">{description}</p>}

                        {
                            authorList.length > 0 && (
                                <AuthorByline
                                    authors={authorList}
                                    class="mt-6"
                                />
                            )
                        }
                        {
                            minutesRead && (
                                <p class="mt-4 font-['Roboto_Mono',monospace] text-xs text-neutral-600 dark:text-neutral-100">
                                    {minutesRead}
                                </p>
                            )
                        }
                    </div>

                    {
                        heroImage && (
                            <figure class="lg:col-span-8">
                                <Image
                                    width={1280}
                                    height={880}
                                    src={heroImage}
                                    alt={title || ""}
                                    class="aspect-[4/3] w-full object-cover md:aspect-[16/11]"
                                    priority
                                />
                                {heroCaption && (
                                    <figcaption class="mt-2 font-['Roboto_Mono',monospace] text-xs text-neutral-600 dark:text-neutral-100">
                                        {heroCaption}
                                    </figcaption>
                                )}
                            </figure>
                        )
                    }
                </div>

                <!-- 內文：左欄旁註（標籤）、右欄正文 -->
                <div
                    class="mt-14 grid gap-8 md:mt-20 lg:grid-cols-12 lg:gap-x-12"
                >
                    <aside class="lg:col-span-4">
                        <div
                            class="flex flex-col gap-4 font-['Roboto_Mono',monospace] lg:sticky lg:top-8"
                        >
                            {
                                tagList.length > 0 && (
                                    <ul class="flex flex-wrap gap-2">
                                        {tagList.map((tag) => (
                                            <li class="border border-black dark:border-white bg-white dark:bg-neutral-900 px-2 py-0.5 text-xs font-bold text-neutral-900 dark:text-neutral-100">
                                                #{tag}
                                            </li>
                                        ))}
                                    </ul>
                                )
                            }
                            <a
                                href="#top"
                                class="hidden text-xs font-bold text-neutral-500 dark:text-neutral-100 transition-colors hover:text-black dark:hover:text-white lg:inline"
                            >
                                Top ↑
                            </a>
                        </div>
                    </aside>

                    <div class="lg:col-span-8 min-w-0">
                        <PasswordGate hash={passwordHash}>
                            <div class="article-body text-neutral-900 dark:text-neutral-100 dark:prose-invert">
                                {Content ? <Content /> : <slot />}
                            </div>
                        </PasswordGate>
                    </div>
                </div>
            </article>
        </main>

        <!-- 底部返回按鈕 -->
        <div
            class="mx-auto mt-4 flex max-w-[720px] items-center justify-between border-t border-black/10 dark:border-white/20 px-4 md:px-6 pb-20 pt-8"
        >
            <button
                type="button"
                id="back-btn-bottom"
                class="group inline-flex items-center gap-2 text-xs font-bold text-[#6600FF] dark:text-[#be9eff] transition-opacity hover:opacity-85 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6600FF]"
            >
                <span class="transition-transform group-hover:-translate-x-1"
                    >←</span
                > Back to previous page
            </button>
            <a
                href="#top"
                class="text-xs font-bold text-neutral-500 dark:text-neutral-100 transition-colors hover:text-black dark:hover:text-white font-['Roboto_Mono',monospace]"
            >
                Top ↑
            </a>
        </div>

        <!-- 隱藏的 friend 卡片模板 -->
        <div id="friend-cards" hidden>
            {
                friendCards.map((f) => (
                    <span
                        data-friend-id={f.id}
                        class="not-prose mx-1 my-2 inline-block align-middle"
                    >
                        <a
                            href={f.mediaLink || "#"}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group block w-[150px] no-underline transition-transform hover:scale-105"
                        >
                            {f.heroImage ? (
                                <FriendPolaroidCard image={f.heroImage} />
                            ) : (
                                <span class="flex h-[200px] w-[150px] items-center justify-center border border-black dark:border-white bg-gray-100 dark:bg-neutral-800 text-xs text-neutral-600 dark:text-neutral-100">
                                    {f.name}
                                </span>
                            )}
                        </a>
                    </span>
                ))
            }
        </div>

        <Giscus />
        <Footer />
    </body>
</html>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        if (reduce) {
            gsap.set(".fade-in", { opacity: 1 });
            return;
        }
        gsap.to(".fade-in", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out",
            startAt: { y: 20 },
        });
    });

    let popover: HTMLElement | null = null;

    const closePopover = () => {
        popover?.remove();
        popover = null;
    };

    document
        .querySelectorAll<HTMLAnchorElement>('.article-body a[href^="friend:"]')
        .forEach((link) => {
            const id = link.getAttribute("href")!.replace("friend:", "");
            const card = document.querySelector(
                `#friend-cards [data-friend-id="${id}"]`,
            );

            link.removeAttribute("href");
            link.setAttribute("role", "button");
            link.setAttribute("tabindex", "0");
            link.style.cursor = "pointer";

            if (!card) return;

            const open = (e: Event) => {
                e.preventDefault();
                e.stopPropagation();
                const isSame = popover?.dataset.for === id;
                closePopover();
                if (isSame) return;

                const rect = link.getBoundingClientRect();
                popover = document.createElement("div");
                popover.dataset.for = id;
                const leftPos = Math.max(
                    12,
                    Math.min(
                        rect.left + window.scrollX,
                        window.innerWidth - 170
                    ),
                );

                popover.style.cssText = `position:absolute;z-index:50;top:${
                    rect.bottom + window.scrollY + 8
                }px;left:${leftPos}px;`;
                popover.appendChild(card.cloneNode(true));
                document.body.appendChild(popover);
            };

            link.addEventListener("click", open);
            link.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") open(e);
            });
        });

    document.addEventListener("click", (e) => {
        if (popover && !popover.contains(e.target as Node)) closePopover();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closePopover();
    });

    const handleBack = () => {
        if (window.history.length > 1) {
            window.history.back();
        } else {
            window.location.href = "/";
        }
    };

    document
        .getElementById("back-btn-top")
        ?.addEventListener("click", handleBack);
    document
        .getElementById("back-btn-bottom")
        ?.addEventListener("click", handleBack);
</script>