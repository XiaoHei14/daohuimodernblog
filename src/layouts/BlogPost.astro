---
// src/layouts/BlogPost.astro  —  Magazine / feature-article layout
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import AuthorByline from "../components/AuthorByline.astro";
import FriendPolaroidCard from "../components/FriendPolaroidCard.astro";
import { getCollection } from "astro:content";
import Giscus from "../components/Giscus.astro";
import "@fontsource/anton";
import "@fontsource/roboto-mono";
import '@fontsource/cormorant-garamond';
// 想要更道地的中文襯線內文：npm i @fontsource/noto-serif-tc 然後取消下面這行註解
// import "@fontsource/noto-serif-tc/400.css";
// import "@fontsource/noto-serif-tc/700.css";

const {
    title,
    description,
    author,
    pubDate,
    updatedDate,
    heroImage,
    heroCaption, // 選填：封面圖說明文字
    tags,
    minutesRead,
    Content,
} = Astro.props;

const authorList = Array.isArray(author) ? author : author ? [author] : [];
const tagList = Array.isArray(tags) ? tags : tags ? [tags] : [];

// 讀取 friends collection（名稱請依專案調整），給 [@xxx](friend:xxx) 用
const friends = await getCollection("friend");
const friendCards = friends.map((f) => ({
    id: f.id.replace(/\.(md|mdx)$/, ""),
    ...f.data,
}));
---

<html lang="zh-Hant" class="scroll-smooth">
    <head>
        <BaseHead title={title} description={description} />
        <style is:global>
            :root {
                --ink: #171717;
                --accent: #6600ff;
                --serif:
                    "Noto Serif TC", "Source Han Serif TC", "Songti TC",
                    "PMingLiU", Georgia, serif;
                --sans-heavy:
                    "Noto Sans TC", "PingFang TC", "Microsoft JhengHei",
                    system-ui, sans-serif;
            }

            /* ---------- 標題：整頁唯一的大動作 ---------- */
            .headline {
                font-family: "Anton", var(--sans-heavy);
                font-weight: 900;
                font-synthesis: none; /* Anton 只有 400，避免假粗體 */
                font-size: clamp(2.5rem, 8.5vw, 7rem);
                line-height: 1.04;
                letter-spacing: -0.01em;
                text-transform: uppercase;
                text-wrap: balance;
                color: var(--ink);
                margin: 0;
            }

            /* ---------- 前言 (standfirst) ---------- */
            .standfirst {
                font-family: var(--serif);
                font-size: 1.25rem;
                line-height: 1.75;
                color: #262626;
                border-top: 2px solid var(--ink);
                padding-top: 1rem;
                margin: 0;
            }

            /* ---------- 內文 ---------- */
            .article-body {
                font-family: var(--serif);
                font-size: 1.125rem;
                line-height: 1.95;
                color: #262626;
                max-width: 42rem;
            }
            .article-body > :first-child {
                margin-top: 0;
            }
            .article-body p {
                margin: 0 0 1.6rem;
            }
            .article-body h2,
            .article-body h3,
            .article-body h4 {
                font-family: var(--sans-heavy);
                color: var(--ink);
                line-height: 1.3;
            }
            .article-body h2 {
                font-size: clamp(1.5rem, 3vw, 2rem);
                font-weight: 800;
                margin: 3.5rem 0 1rem;
            }
            .article-body h2::before {
                content: "";
                display: block;
                width: 2.5rem;
                height: 4px;
                background: var(--accent);
                margin-bottom: 1rem;
            }
            .article-body h3 {
                font-size: 1.3rem;
                font-weight: 700;
                margin: 2.5rem 0 0.75rem;
            }
            .article-body h4 {
                font-size: 1.1rem;
                font-weight: 700;
                margin: 2rem 0 0.5rem;
            }
            .article-body ul,
            .article-body ol {
                margin: 0 0 1.6rem;
                padding-left: 1.5rem;
            }
            .article-body ul {
                list-style: disc;
            }
            .article-body ol {
                list-style: decimal;
            }
            .article-body li {
                margin-bottom: 0.5rem;
                line-height: 1.8;
            }
            .article-body li::marker {
                color: var(--accent);
            }
            .article-body a {
                color: var(--accent);
                text-decoration: underline;
                text-decoration-thickness: 1px;
                text-underline-offset: 4px;
            }
            .article-body a[href^="friend:"],
            .article-body a[role="button"] {
                font-weight: 700;
                text-decoration-style: dotted;
            }
            .article-body a:hover {
                text-decoration-thickness: 2px;
            }

            /* 引言 → 雜誌 pull quote */
            .article-body blockquote {
                margin: 2.75rem 0;
                padding: 1.25rem 0;
                border-top: 2px solid var(--ink);
                border-bottom: 1px solid rgba(0, 0, 0, 0.2);
                font-size: 1.5rem;
                line-height: 1.6;
                font-weight: 600;
                font-style: normal;
                color: var(--ink);
            }
            .article-body blockquote p {
                margin: 0 0 0.75rem;
            }
            .article-body blockquote p:last-child {
                margin-bottom: 0;
            }

            /* 圖片與圖說 */
            .article-body img {
                display: block;
                width: 100%;
                height: auto;
                margin: 2.25rem 0 0.75rem;
            }
            .article-body figure {
                margin: 2.25rem 0;
            }
            .article-body figure img {
                margin: 0 0 0.6rem;
            }
            .article-body figcaption {
                font-family: "Roboto Mono", monospace;
                font-size: 0.75rem;
                line-height: 1.6;
                color: #737373;
            }
            .article-body hr {
                border: 0;
                border-top: 1px solid rgba(0, 0, 0, 0.2);
                margin: 3rem 0;
            }

            /* 程式碼 */
            .article-body code {
                font-family: "Roboto Mono", monospace;
                background-color: rgba(0, 0, 0, 0.05);
                padding: 0.15rem 0.4rem;
                font-size: 0.85em;
            }
            .article-body pre {
                background-color: #1a1a1a;
                color: #f8f8f2;
                padding: 1.25rem;
                overflow-x: auto;
                margin: 0 0 1.75rem;
                font-size: 0.875rem;
                line-height: 1.7;
            }
            .article-body pre code {
                background-color: transparent;
                padding: 0;
                color: inherit;
                font-size: inherit;
            }

            @media (max-width: 640px) {
                .article-body {
                    font-size: 1.0625rem;
                }
                .standfirst {
                    font-size: 1.125rem;
                }
            }
        </style>
    </head>

    <body
        class="bg-neutral-50 text-neutral-900 antialiased selection:bg-[#6600FF] selection:text-white"
    >
        <!-- 導航列 + 期刊資訊列 -->
        <div class="px-6 md:px-12 pt-6 font-['Roboto_Mono',monospace]">
            <Header />

            <nav
                class="max-w-[1280px] mx-auto mt-8 flex items-center justify-between gap-4 border-b border-black pb-3 text-xs"
                aria-label="Article Navigation"
            >
                <button
                    type="button"
                    id="back-btn-top"
                    class="group inline-flex items-center gap-2 font-bold text-[#6600FF] transition-opacity hover:opacity-80 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6600FF]"
                >
                    <span class="transition-transform group-hover:-translate-x-1"
                        >←</span
                    > Back to list
                </button>
                <div class="flex items-center gap-2 text-neutral-500">
                    <FormattedDate date={pubDate} />
                    {
                        updatedDate && (
                            <span class="italic text-neutral-400">
                                (Updated: <FormattedDate date={updatedDate} />)
                            </span>
                        )
                    }
                </div>
            </nav>
        </div>

        <!-- 主內容區 -->
        <main class="fade-in opacity-0">
            <article
                id="top"
                class="mx-auto max-w-[1280px] px-6 pb-16 pt-10 md:px-12 md:pt-16"
            >
                <!-- 開場：超大標題 -->
                <header>
                    <h1 class="headline">{title}</h1>
                </header>

                <!-- 開場：前言 + 封面圖（桌機 4 / 8 欄） -->
                <div
                    class="mt-8 grid gap-8 md:mt-12 lg:grid-cols-12 lg:gap-x-12"
                >
                    <div
                        class={heroImage
                            ? "lg:col-span-4"
                            : "lg:col-span-8 lg:col-start-5"}
                    >
                        {description && <p class=" font-['cormorant_garamond'] italic">{description}</p>}

                        {
                            authorList.length > 0 && (
                                <AuthorByline
                                    authors={authorList}
                                    class="mt-6"
                                />
                            )
                        }
                        {
                            minutesRead && (
                                <p class="mt-4 font-['Roboto_Mono',monospace] text-xs text-neutral-500">
                                    {minutesRead}
                                </p>
                            )
                        }
                    </div>

                    {
                        heroImage && (
                            <figure class="lg:col-span-8">
                                <Image
                                    width={1280}
                                    height={880}
                                    src={heroImage}
                                    alt={title || ""}
                                    class="aspect-[4/3] w-full object-cover md:aspect-[16/11]"
                                    priority
                                />
                                {heroCaption && (
                                    <figcaption class="mt-2 font-['Roboto_Mono',monospace] text-xs text-neutral-500">
                                        {heroCaption}
                                    </figcaption>
                                )}
                            </figure>
                        )
                    }
                </div>

                <!-- 內文：左欄旁註（標籤）、右欄正文 -->
                <div
                    class="mt-14 grid gap-8 md:mt-20 lg:grid-cols-12 lg:gap-x-12"
                >
                    <aside class="lg:col-span-4">
                        <div
                            class="flex flex-col gap-4 font-['Roboto_Mono',monospace] lg:sticky lg:top-8"
                        >
                            {
                                tagList.length > 0 && (
                                    <ul class="flex flex-wrap gap-2">
                                        {tagList.map((tag) => (
                                            <li class="border border-black bg-white px-2 py-0.5 text-xs font-bold text-neutral-800">
                                                #{tag}
                                            </li>
                                        ))}
                                    </ul>
                                )
                            }
                            <a
                                href="#top"
                                class="hidden text-xs font-bold text-neutral-400 transition-colors hover:text-black lg:inline"
                            >
                                Top ↑
                            </a>
                        </div>
                    </aside>

                    <div class="lg:col-span-8">
                        <div class="article-body">
                            {Content ? <Content /> : <slot />}
                        </div>
                    </div>
                </div>
            </article>
        </main>

        <!-- 底部返回按鈕 -->
        <div
            class="mx-auto mt-4 flex max-w-[720px] items-center justify-between border-t border-black/10 px-6 pb-20 pt-8"
        >
            <button
                type="button"
                id="back-btn-bottom"
                class="group inline-flex items-center gap-2 text-xs font-bold text-[#6600FF] transition-opacity hover:opacity-85 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6600FF]"
            >
                <span class="transition-transform group-hover:-translate-x-1"
                    >←</span
                > Back to previous page
            </button>
            <a
                href="#top"
                class="text-xs font-bold text-neutral-400 transition-colors hover:text-black"
            >
                Top ↑
            </a>
        </div>

        <!-- 隱藏的 friend 卡片模板：script 會把文章裡的 [@xxx](friend:xxx) 換成這些卡片 -->
        <div id="friend-cards" hidden>
            {
                friendCards.map((f) => (
                    <span
                        data-friend-id={f.id}
                        class="not-prose mx-1 my-2 inline-block align-middle"
                    >
                        <a
                            href={f.mediaLink || "#"}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group block w-[150px] no-underline transition-transform hover:scale-105"
                        >
                            {f.heroImage ? (
                                <FriendPolaroidCard image={f.heroImage} />
                            ) : (
                                <span class="flex h-[200px] w-[150px] items-center justify-center border border-black bg-gray-100 text-xs text-neutral-400">
                                    {f.name}
                                </span>
                            )}
                        </a>
                    </span>
                ))
            }
        </div>

        <Giscus />
        <Footer />
    </body>
</html>

<script>
    import { gsap } from "gsap";

    // 進場動畫只做一次；使用者偏好減少動態時直接顯示
    document.addEventListener("DOMContentLoaded", () => {
        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        if (reduce) {
            gsap.set(".fade-in", { opacity: 1 });
            return;
        }
        gsap.to(".fade-in", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out",
            startAt: { y: 20 },
        });
    });

    // 文章裡的 [@daohui](friend:daohui) 只顯示 @id，點擊後才彈出 FriendPolaroidCard
    let popover: HTMLElement | null = null;

    const closePopover = () => {
        popover?.remove();
        popover = null;
    };

    document
        .querySelectorAll<HTMLAnchorElement>('.article-body a[href^="friend:"]')
        .forEach((link) => {
            const id = link.getAttribute("href")!.replace("friend:", "");
            const card = document.querySelector(
                `#friend-cards [data-friend-id="${id}"]`,
            );

            link.removeAttribute("href");
            link.setAttribute("role", "button");
            link.setAttribute("tabindex", "0");
            link.style.cursor = "pointer";

            if (!card) return; // 找不到對應的 friend：維持純文字樣式

            const open = (e: Event) => {
                e.preventDefault();
                e.stopPropagation();
                const isSame = popover?.dataset.for === id;
                closePopover();
                if (isSame) return; // 再點一次就收起

                const rect = link.getBoundingClientRect();
                popover = document.createElement("div");
                popover.dataset.for = id;
                popover.style.cssText = `position:absolute;z-index:50;top:${
                    rect.bottom + window.scrollY + 8
                }px;left:${Math.max(
                    8,
                    Math.min(
                        rect.left + window.scrollX,
                        window.innerWidth - 170,
                    ),
                )}px;`;
                popover.appendChild(card.cloneNode(true));
                document.body.appendChild(popover);
            };

            link.addEventListener("click", open);
            link.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") open(e);
            });
        });

    // 點卡片以外的地方或按 Esc 關閉
    document.addEventListener("click", (e) => {
        if (popover && !popover.contains(e.target as Node)) closePopover();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closePopover();
    });

    const handleBack = () => {
        if (window.history.length > 1) {
            window.history.back();
        } else {
            window.location.href = "/";
        }
    };

    document
        .getElementById("back-btn-top")
        ?.addEventListener("click", handleBack);
    document
        .getElementById("back-btn-bottom")
        ?.addEventListener("click", handleBack);
</script>