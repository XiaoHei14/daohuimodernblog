---
// src/layouts/BlogPost.astro
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import FriendPolaroidCard from "../components/FriendPolaroidCard.astro";
import { getCollection } from "astro:content";
import Giscus from "../components/Giscus.astro";
import "@fontsource/anton";
import "@fontsource/roboto-mono";

const {
    title,
    description,
    pubDate,
    updatedDate,
    heroImage,
    tags,
    minutesRead,
    Content,
} = Astro.props;

const tagList = Array.isArray(tags) ? tags : tags ? [tags] : [];

// 讀取 friends collection（名稱請依專案調整），給 [@xxx](friend:xxx) 用
const friends = await getCollection("friend");
const friendCards = friends.map((f) => ({
    id: f.id.replace(/\.(md|mdx)$/, ""),
    ...f.data,
}));
---

<html lang="zh-Hant" class="scroll-smooth">
    <head>
        <BaseHead title={title} description={description} />
        <style>
            .prose {
                max-width: 720px;
                margin: auto;
                color: rgb(var(--gray-dark, 51 51 51));
                font-family: "Roboto Mono", monospace;
            }
            .prose p {
                margin-bottom: 1.5rem;
                line-height: 1.8;
            }
            .prose h1,
            .prose h2,
            .prose h3,
            .prose h4 {
                font-weight: bold;
                margin-top: 2.5rem;
                margin-bottom: 1rem;
                line-height: 1.3;
            }
            .prose h2 {
                font-size: 1.75rem;
                border-bottom: 1px solid rgba(0, 0, 0, 0.1);
                padding-bottom: 0.5rem;
            }
            .prose h3 {
                font-size: 1.35rem;
            }
            .prose ul,
            .prose ol {
                margin-bottom: 1.5rem;
                padding-left: 1.5rem;
            }
            .prose ul {
                list-style-type: disc;
            }
            .prose ol {
                list-style-type: decimal;
            }
            .prose li {
                margin-bottom: 0.5rem;
                line-height: 1.6;
            }
            .prose a {
                color: #6600ff;
                text-decoration: underline;
            }
            .prose blockquote {
                border-left: 4px solid #6600ff;
                padding-left: 1rem;
                margin: 1.5rem 0;
                color: #555;
                font-style: italic;
            }
            .prose code {
                background-color: rgba(0, 0, 0, 0.05);
                padding: 0.2rem 0.4rem;
                border-radius: 4px;
                font-size: 0.9em;
            }
            .prose pre {
                background-color: #1a1a1a;
                color: #f8f8f2;
                padding: 1rem;
                border-radius: 8px;
                overflow-x: auto;
                margin-bottom: 1.5rem;
            }
            .prose pre code {
                background-color: transparent;
                padding: 0;
                color: inherit;
            }
        </style>
    </head>

    <body
        class="bg-neutral-50 text-neutral-900 antialiased selection:bg-[#6600FF] selection:text-white"
    >
        <!-- 導航列與頂部返回區塊 -->
        <div class="px-6 md:px-12 pt-6 font-['Roboto_Mono',monospace]">
            <Header />

            <nav
                class="max-w-[1020px] mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-black/15 pb-4 text-xs uppercase tracking-widest mt-8 gap-4"
                aria-label="Article Navigation"
            >
                <div
                    class="date text-xs text-neutral-500 font-['Roboto_Mono',monospace] flex items-center justify-center gap-2"
                >
                    <FormattedDate date={pubDate} />
                    {
                        updatedDate && (
                            <span class="last-updated-on italic text-neutral-400">
                                (Updated: <FormattedDate date={updatedDate} />)
                            </span>
                        )
                    }
                </div>
                {
                    minutesRead && (
                        <span class="text-neutral-400">{minutesRead}</span>
                    )
                }
                <button
                    type="button"
                    id="back-btn-top"
                    class="group relative inline-flex items-center gap-2 text-[#6600FF] font-bold hover:opacity-80 transition-all cursor-pointer uppercase"
                >
                    <span
                        class="transition-transform group-hover:-translate-x-1"
                        >←</span
                    > BACK TO LIST
                </button>
            </nav>
        </div>

        <!-- 主內容區 -->
        <main class="fade-in opacity-0">
            <article id="top" class="py-10 md:py-16">
                <!-- 文章標題與 Meta 資訊 -->
                <header class="max-w-[720px] mx-auto px-6 mb-10 text-center">
                    {
                        tagList.length > 0 && (
                            <div class="flex flex-wrap justify-center gap-2 mb-4">
                                {tagList.map((tag) => (
                                    <span class="border border-black/20 bg-white px-2.5 py-1 font-['Roboto_Mono',monospace] text-[10px] font-bold uppercase tracking-wider text-neutral-600 rounded-md shadow-xs">
                                        #{tag}
                                    </span>
                                ))}
                            </div>
                        )
                    }

                    <h1
                        class="text-3xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight"
                    >
                        {title}
                    </h1>
                </header>

                <!-- 封面圖片 (Hero Image) -->
                {
                    heroImage && (
                        <div class="max-w-[1020px] mx-auto px-6 mb-14">
                            <div class="rounded-2xl overflow-hidden shadow-xl border border-black/10 bg-white">
                                <Image
                                    width={1020}
                                    height={510}
                                    src={heroImage}
                                    alt={title || ""}
                                    class="max-h-[510px] w-full h-auto object-cover hover:scale-[1.01] transition-transform duration-500"
                                    priority
                                />
                            </div>
                        </div>
                    )
                }

                <!-- 文章內文 -->
                <div class="prose prose-neutral px-6">
                    {Content ? <Content /> : <slot />}
                </div>
            </article>
        </main>

        <!-- 底部返回按鈕 -->
        <div
            class="max-w-[720px] mx-auto px-6 pb-20 pt-8 border-t border-black/10 mt-12 flex justify-between items-center"
        >
            <button
                type="button"
                id="back-btn-bottom"
                class="group inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#6600FF] hover:opacity-85 transition-all cursor-pointer"
            >
                <span class="transition-transform group-hover:-translate-x-1"
                    >←</span
                > Back to previous page
            </button>
            <a
                href="#top"
                class="text-xs font-bold uppercase tracking-wider text-neutral-400 hover:text-black transition-colors"
            >
                Top ↑
            </a>
        </div>

        <!-- 隱藏的 friend 卡片模板：script 會把文章裡的 [@xxx](friend:xxx) 換成這些卡片 -->
        <div id="friend-cards" hidden>
            {
                friendCards.map((f) => (
                    <span
                        data-friend-id={f.id}
                        class="not-prose mx-1 my-2 inline-block align-middle"
                    >
                        <a
                            href={f.mediaLink || "#"}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group block w-[150px] no-underline transition-transform hover:scale-105"
                        >
                            {f.heroImage ? (
                                <FriendPolaroidCard image={f.heroImage} />
                            ) : (
                                <span class="flex h-[200px] w-[150px] items-center justify-center border border-black bg-gray-100 text-xs text-neutral-400">
                                    {f.name}
                                </span>
                            )}
                        </a>
                    </span>
                ))
            }
        </div>

        <Giscus />
        <Footer />
    </body>
</html>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        gsap.to(".fade-in", {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out",
            startAt: { y: 20 },
        });
    });

    // 文章裡的 [@daohui](friend:daohui) 只顯示 @id，點擊後才彈出 FriendPolaroidCard
    let popover: HTMLElement | null = null;

    const closePopover = () => {
        popover?.remove();
        popover = null;
    };

    document
        .querySelectorAll<HTMLAnchorElement>('.prose a[href^="friend:"]')
        .forEach((link) => {
            const id = link.getAttribute("href")!.replace("friend:", "");
            const card = document.querySelector(
                `#friend-cards [data-friend-id="${id}"]`,
            );

            link.removeAttribute("href");
            link.setAttribute("role", "button");
            link.setAttribute("tabindex", "0");
            link.style.cursor = "pointer";

            if (!card) return; // 找不到對應的 friend：維持純文字樣式

            const open = (e: Event) => {
                e.preventDefault();
                e.stopPropagation();
                const isSame = popover?.dataset.for === id;
                closePopover();
                if (isSame) return; // 再點一次就收起

                const rect = link.getBoundingClientRect();
                popover = document.createElement("div");
                popover.dataset.for = id;
                popover.style.cssText = `position:absolute;z-index:50;top:${
                    rect.bottom + window.scrollY + 8
                }px;left:${Math.max(
                    8,
                    Math.min(
                        rect.left + window.scrollX,
                        window.innerWidth - 170,
                    ),
                )}px;`;
                popover.appendChild(card.cloneNode(true));
                document.body.appendChild(popover);
            };

            link.addEventListener("click", open);
            link.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") open(e);
            });
        });

    // 點卡片以外的地方或按 Esc 關閉
    document.addEventListener("click", (e) => {
        if (popover && !popover.contains(e.target as Node)) closePopover();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closePopover();
    });

    const handleBack = () => {
        if (window.history.length > 1) {
            window.history.back();
        } else {
            window.location.href = "/";
        }
    };

    document
        .getElementById("back-btn-top")
        ?.addEventListener("click", handleBack);
    document
        .getElementById("back-btn-bottom")
        ?.addEventListener("click", handleBack);
</script>