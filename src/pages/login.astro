---
import "@fontsource/anton";
import "@fontsource/roboto-mono";
import "@fontsource/cormorant-garamond";

import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

const error = Astro.url.searchParams.get("error");

const errorMessage =
  error === "credentials"
    ? "登入失敗，請確認 Email 和密碼。"
    : error === "oauth"
      ? "GitHub 登入失敗，請重新嘗試。"
      : null;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <BaseHead
      title="Dashboard Login | DaoHui Blog"
      description="Access restricted dashboard area."
    />
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body
    class="min-h-screen flex flex-col justify-between overflow-x-hidden bg-[#F5F3ED] font-['Roboto_Mono',monospace] text-neutral-900 selection:bg-[#6600FF] selection:text-white transition-colors duration-300 dark:bg-[#0F172A] dark:text-neutral-100"
  >
    <div class="w-full px-4 py-8 sm:px-6 md:px-12">
      <Header />

      <main class="mx-auto mt-12 w-full max-w-[480px] md:mt-20">
        <div
          class="mb-8 flex items-center justify-between border-b border-black/20 pb-4 text-xs tracking-wider dark:border-white/20"
        >
          <span
            class="inline-block bg-neutral-900 px-2 py-0.5 font-bold text-white dark:bg-white dark:text-neutral-900"
          >
            AUTH // 01
          </span>

          <span class="font-bold text-[#6600FF]">
            SECURE AREA →
          </span>
        </div>

        <div class="mb-8 space-y-3">
          <span
            class="inline-block text-xs font-bold uppercase tracking-widest text-[#6600FF]"
          >
            [ Restricted Access ]
          </span>

          <h1
            class="font-['Anton',sans-serif] text-5xl uppercase tracking-tight text-neutral-900 dark:text-white sm:text-6xl"
          >
            Dashboard<span class="text-[#6600FF]">.</span>
          </h1>

          <p
            class="font-['Cormorant_Garamond',serif] text-lg italic text-neutral-600 dark:text-neutral-400 sm:text-xl"
          >
            Please authenticate to manage the system.
          </p>
        </div>

        <div
          class="space-y-6 border-2 border-neutral-900 bg-white/50 p-6 shadow-2xl backdrop-blur-sm dark:border-white dark:bg-neutral-900/50 sm:p-8"
        >
          {errorMessage && (
            <p
              role="alert"
              class="border-l-4 border-[#6600FF] bg-[#6600FF]/10 p-3 text-xs leading-6"
            >
              {errorMessage}
            </p>
          )}

          <a
            href="/api/auth/github"
            class="inline-flex w-full items-center justify-center gap-3 bg-neutral-900 px-6 py-3 text-xs font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-85 dark:bg-white dark:text-neutral-900"
          >
            <svg
              class="h-4 w-4 shrink-0 fill-current"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              />
            </svg>

            <span>Sign in with GitHub</span>
          </a>

          <div class="flex items-center gap-4 py-2">
            <div
              class="flex-grow border-t border-black/10 dark:border-white/10"
            ></div>

            <span
              class="shrink-0 text-[10px] uppercase text-neutral-400"
            >
              Or system login
            </span>

            <div
              class="flex-grow border-t border-black/10 dark:border-white/10"
            ></div>
          </div>

          <form
            action="/api/auth/login"
            method="POST"
            class="space-y-5"
          >
            <div>
              <label
                for="email"
                class="mb-1 block text-[11px] font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
              >
                Email
              </label>

              <input
                id="email"
                type="email"
                name="email"
                required
                autocomplete="username"
                placeholder="Enter email"
                class="w-full border-b border-black/80 bg-transparent py-2 text-sm text-neutral-900 focus:border-[#6600FF] focus:outline-none dark:border-white/80 dark:text-white"
              />
            </div>

            <div>
              <label
                for="password"
                class="mb-1 block text-[11px] font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
              >
                Password
              </label>

              <input
                id="password"
                type="password"
                name="password"
                required
                autocomplete="current-password"
                placeholder="Enter password"
                class="w-full border-b border-black/80 bg-transparent py-2 text-sm text-neutral-900 focus:border-[#6600FF] focus:outline-none dark:border-white/80 dark:text-white"
              />
            </div>

            <button
              type="submit"
              class="w-full cursor-pointer bg-[#6600FF] py-3 text-xs font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-85"
            >
              Authenticate →
            </button>
          </form>
        </div>
      </main>
    </div>

    <footer
      class="border-t border-black/10 px-4 py-6 text-center text-xs text-neutral-500 dark:border-white/10 sm:px-6 md:px-12"
    >
      AUTHORIZED PERSONNEL ONLY
    </footer>
  </body>
</html>
