---
import { getCollection, render } from 'astro:content';
import '@fontsource/anton';
import '@fontsource/roboto-mono';
import FriendPolaroidCard from '../../components/FriendPolaroidCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import { X, MessageSquare, ArrowUpRight } from '@lucide/astro';

const friends = await getCollection('friend');

// 預先將每個 friend 的 Markdown 內容在伺服器端渲染好供彈窗使用
const friendsWithContent = await Promise.all(
    friends.map(async (friend) => {
        const { Content } = await render(friend);
        return { ...friend, Content };
    })
);
---

<BaseHead title="Friends - DaoHui Blog" description="友站"/>

<body class="min-h-screen bg-[#F5F3ED] dark:bg-[#0F172A] text-neutral-900 dark:text-neutral-100 flex flex-col justify-between selection:bg-[#6600FF] selection:text-white">
<div>
    <div class="px-6 md:px-12 py-12 font-['roboto_mono']">
        <Header />
        <div class="mx-auto w-full max-w-[1200px] space-y-10 mt-8">
            
            <!-- 頂部標題 -->
            <div class="flex justify-between items-center border-b border-black/20 dark:border-white/20 pb-4 text-xs uppercase tracking-wider">
                <span>04 / FRIENDS & CONNECTIONS</span>
                <span class="text-[#6600FF] dark:text-[#a78bfa]">NETWORK DIRECTORY</span>
            </div>

            <h1 class="font-['Anton'] text-5xl sm:text-7xl uppercase tracking-tight">
                Friends
            </h1>

            <!-- 列表網格 (改成 button 以觸發彈窗) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    friendsWithContent.map((friend, index) => (
                        <button 
                            type="button"
                            data-modal-target={`modal-${friend.id}`}
                            class="group flex flex-col items-center text-center gap-6 cursor-pointer"
                        >
                            <!-- 拍立得圖片 (若有設定 heroImage 則顯示) -->
                            {friend.data.heroImage ? (
                                <div class={`transform duration-300 pointer-events-none ${index % 2 === 0 ? 'rotate-[-4deg]' : 'rotate-[4deg]'}`}>
                                    <FriendPolaroidCard image={friend.data.heroImage} />
                                </div>
                            ) : (
                                <div class="w-[150px] h-[168px] bg-gray-200 dark:bg-gray-800 flex items-center justify-center text-xs text-neutral-400 font-['roboto_mono'] border-2 border-black dark:border-white/20">
                                    NO IMAGE
                                </div>
                            )}

                            <!-- 名字與標籤 -->
                            <div class="w-full flex flex-col gap-1">
                                <span class="text-[10px] text-[#6600FF] dark:text-[#a78bfa] font-light tracking-wider">PROFILE</span>
                                <h2 class="font-['roboto_mono'] font-light leading-none text-3xl uppercase tracking-wide group-hover:text-[#6600FF] dark:group-hover:text-[#a78bfa] transition-colors">
                                    {friend.data.name}
                                </h2>
                            </div>
                        </button>
                    ))
                }
            </div>
        </div>
    </div>
</div>

<!-- 新設計的 Footer -->
<footer class="w-full bg-[#DDF1FF] dark:bg-[#1E293B] border-t-2 border-black dark:border-white/20 py-10 px-6 md:px-12 font-['roboto-mono',monospace] text-neutral-900 dark:text-neutral-100 transition-colors">
    <div class="mx-auto max-w-[1200px] flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        
        <!-- 左側：Discord 互動引導 -->
        <div class="flex items-center gap-3 bg-white dark:bg-slate-800 border-2 border-black dark:border-white/30 px-4 py-3 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.2)]">
            <MessageSquare class="w-5 h-5 text-[#6600FF] dark:text-[#a78bfa] shrink-0" />
            <span class="text-xs sm:text-sm font-bold tracking-tight">
                想交換友站或聊天？加我 Discord：<span class="text-[#6600FF] dark:text-[#a78bfa] underline underline-offset-4">daohui_.</span>
                <br/>
                <pre>
名子:DaoHui
簡介:嘻嘻
頭像:https://daohuimodernblog.vercel.app/avatar.jpg
網站:https://daohuimodernblog.vercel.app
                </pre>
            </span>
        </div>

        <!-- 右側：版權與小標示 -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-neutral-400">
            <span>© {new Date().getFullYear()} DaoHui Blog</span>
            <span class="hidden sm:inline">/</span>
            <a 
                href="https://discord.com/users/962217639764164608" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-black dark:text-white hover:text-[#6600FF] dark:hover:text-[#a78bfa] transition-colors"
            >
                Discord Connect <ArrowUpRight class="w-3.5 h-3.5" />
            </a>
        </div>

    </div>
</footer>
</body>

<!-- 彈窗渲染區 (Modal Containers) -->
{
    friendsWithContent.map((friend) => {
        const { Content } = friend;
        return (
            <div 
                id={`modal-${friend.id}`}
                class="friend-modal fixed inset-0 z-50 flex items-center justify-center p-4 hidden"
                style="backdrop-filter: blur(4px); opacity: 0;"
            >
                {/* 拍立得風格的大彈窗本體 */}
                <div class="modal-content bg-white dark:bg-slate-900 text-neutral-900 dark:text-neutral-100 w-full max-w-xl max-h-[85vh] overflow-y-auto p-6 sm:p-8 pb-12 border-2 border-black dark:border-white shadow-2xl relative rotate-1 opacity-0 scale-90">
                    
                    <div class="mb-2 flex items-center justify-between px-1 font-['roboto_mono'] text-[9px] text-[#6600FF] dark:text-[#a78bfa] font-bold">
                        <span>ANOTHER SIDE</span>
                        {/* 關閉按鈕 */}
                        <button 
                            type="button"
                            class="modal-close absolute top-4 right-4 p-2 text-neutral-600 dark:text-neutral-300 hover:text-[#6600FF] transition-colors cursor-pointer z-10 bg-white/80 dark:bg-slate-800/80 rounded-full border border-black/10 dark:border-white/20"
                            aria-label="Close modal"
                        >
                            <X class="w-6 h-6" />
                        </button>
                    </div>

                    {/* 如果友人有設定圖片，可以在彈窗內搭配顯示拍立得照片 */}
                    {friend.data.heroImage && (
                        <div class="mb-6 bg-white dark:bg-slate-800 p-3 max-w-[200px] mx-auto sm:mx-0 border border-black/10 dark:border-white/10">
                            <div class="h-[200px] w-full overflow-hidden bg-gray-200 dark:bg-gray-700">
                                <img
                                    src={friend.data.heroImage.src}
                                    alt={friend.data.name}
                                    class="h-full w-full object-cover"
                                />
                            </div>
                        </div>
                    )}

                    {/* 彈窗頂部：名字與連結 */}
                    <div class="space-y-3 pr-8 mb-6 border-b border-black/10 dark:border-white/10 pb-4">
                        <span class="text-[10px] text-[#6600FF] dark:text-[#a78bfa] font-bold uppercase">POLAROID // {friend.id}</span>
                        <h2 class="font-['Anton'] text-4xl sm:text-5xl uppercase tracking-tight">{friend.data.name}</h2>
                        
                        {friend.data.mediaLink && (
                            <a 
                                href={friend.data.mediaLink} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="inline-block px-3 py-1 bg-[#6600FF] text-white text-[10px] font-bold uppercase tracking-wider shadow-sm hover:opacity-90 transition-opacity"
                            >
                                Visit Site ↗
                            </a>
                        )}
                    </div>

                    {/* 彈窗內文（Markdown） */}
                    <div class="prose prose-neutral dark:prose-invert max-w-none font-['roboto_mono'] text-sm leading-relaxed">
                        <Content />
                    </div>
                </div>
            </div>
        );
    })
}

<!-- GSAP 動畫與互動控制腳本 -->
<script>
    import { gsap } from 'gsap';

    const modalTriggers = document.querySelectorAll('[data-modal-target]');
    const modals = document.querySelectorAll('.friend-modal');

    modalTriggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
            const targetId = trigger.getAttribute('data-modal-target');
            if (targetId) {
                const modal = document.getElementById(targetId);
                if (modal) {
                    const content = modal.querySelector('.modal-content');

                    modal.classList.remove('hidden');

                    gsap.to(modal, {
                        opacity: 1,
                        duration: 0.3,
                        ease: 'power2.out'
                    });

                    gsap.fromTo(content, 
                        { scale: 0.9, opacity: 0, y: 20, rotation: 3 }, 
                        { scale: 1, opacity: 1, y: 0, rotation: 1, duration: 0.45, ease: 'back.out(1.4)', delay: 0.05 }
                    );
                }
            }
        });
    });

    modals.forEach(modal => {
        const closeBtn = modal.querySelector('.modal-close');
        const content = modal.querySelector('.modal-content');

        const closeModal = () => {
            gsap.to(content, {
                scale: 0.9,
                opacity: 0,
                y: 10,
                duration: 0.25,
                ease: 'power2.in'
            });

            gsap.to(modal, {
                opacity: 0,
                duration: 0.25,
                ease: 'power2.in',
                onComplete: () => {
                    modal.classList.add('hidden');
                }
            });
        };

        closeBtn?.addEventListener('click', closeModal);

        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });
    });
</script>