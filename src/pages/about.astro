---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import '@fontsource/anton';
import '@fontsource/roboto-mono';
import '@fontsource/cormorant-garamond';
import ChodanPostCard from '../assets/chodan2.jpeg';
import { X, MessageSquare, ArrowUpRight } from '@lucide/astro';

const mediaLink = [
    {  label: 'Discord', href: 'https://discord.com/users/962217639764164608' },
    {  label: 'Email', href: 'mailto:xiahey587@gmail.com' },
    {  label: 'Twitter', href: 'https://x.com/daohui587' },
    {  label: 'BugCrowd',href: 'https://bugcrowd.com/h/DaoHui'}
]
---

<BaseLayout title="About Me -">
    <div class="min-h-screen dark:bg-[#09090B]  overflow-x-hidden px-6 md:px-12 py-12 text-neutral-900 font-['Roboto_Mono']">
        <div class="mx-auto w-full max-w-[1200px] flex flex-col gap-16">
            
            <!-- 頂部導覽列 / 標籤 -->
            <div class="flex dark:text-[#F5F3ED] justify-between items-center border-b border-black/20 pb-4 text-xs uppercase tracking-wider text-neutral-600">
                <span>02 / ABOUT ME</span>
                <span class="text-[#6600FF]">TAIWAN — CS & SECURITY RESEARCHER</span>
            </div>

            <!-- 主標題區：名稱與核心引言 -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
                <div class="lg:col-span-7 space-y-6 dark:text-[#F5F3ED]">
                    <h1 class="font-['anton'] text-6xl sm:text-8xl uppercase tracking-tight leading-none">
                        DaoHui
                    </h1>
                    <p class="dark:text-[#F5F3ED] font-['cormorant_garamond'] text-xl sm:text-2xl italic text-neutral-700 leading-relaxed max-w-2xl">
                        "Exploring the delicate boundary between software logic, binary exploitation, and hardware-level AI security."
                    </p>
                    <div class="h-[2px] w-16 bg-[#6600FF]"></div>
                </div>

                <!-- 拍立得裝飾與個人簡介 -->
                <div class="lg:col-span-5 flex flex-col sm:flex-row gap-6 items-center lg:justify-end">
                    <div class="space-y-4 text-xs sm:text-sm leading-relaxed text-neutral-70 dark:text-[#F5F3ED]">
                        <p>
                            嗨！我是DaoHui，一名來自台灣的高中生與資安、系統開發愛好者。
                        </p>
                        <p>
                            長期專注於網路安全、逆向工程、CTF 競賽以及硬體安全研究，特別是探索硬體加速器與 AI 系統交界處的潛在資安威脅。
                        </p>
                    </div>
                </div>
            </div>

            <!-- 詳細經歷與專業領域 (Grid 佈局) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pt-4">
                
                <!-- 專長 1：CTF & 資安 -->
                <div class="bg-white p-6 shadow-md border border-black/10 flex flex-col justify-between space-y-4 transition-transform duration-300 hover:-translate-y-1">
                    <div class="text-xs text-[#6600FF] font-bold">01 / SECURITY & CTF</div>
                    <div class="space-y-2">
                        <h3 class="font-['Anton'] text-2xl uppercase">Capture The Flag</h3>
                        <p class="text-xs text-neutral-600 leading-relaxed">
                            活躍於各大資安競賽與培訓計畫（如 AIS3 Junior、THJCC 等）。擅長 Web 安全、密碼學、逆向工程與二進位漏洞挖掘。
                        </p>
                    </div>
                </div>

                <!-- 專長 2：硬體安全與研究 -->
                <div class="bg-white p-6 shadow-md border border-black/10 flex flex-col justify-between space-y-4 transition-transform duration-300 hover:-translate-y-1">
                    <div class="text-xs text-[#6600FF] font-bold">02 / HARDWARE RESEARCH</div>
                    <div class="space-y-2">
                        <h3 class="font-['Anton'] text-2xl uppercase">Hardware Security</h3>
                        <p class="text-xs text-neutral-600 leading-relaxed">
                            深入研究硬體架構安全，曾撰寫探討 FPGA 加速器應用於 AIoT 環境所產生之資安危害與防護機制的專題研究。
                        </p>
                    </div>
                </div>

                <!-- 專長 3：系統開發與工具 -->
                <div class="bg-white p-6 shadow-md border border-black/10 flex flex-col justify-between space-y-4 transition-transform duration-300 hover:-translate-y-1">
                    <div class="text-xs text-[#6600FF] font-bold">03 / DEVELOPMENT</div>
                    <div class="space-y-2">
                        <h3 class="font-['Anton'] text-2xl uppercase">Systems & Scripting</h3>
                        <p class="text-xs text-neutral-600 leading-relaxed">
                            熟練運用 Python 進行自動化與安全工具開發。熱衷於 Linux 系統管理（Arch Linux / Ubuntu）、Docker 容器化部署與 Neovim 開發環境配置。
                        </p>
                    </div>
                </div>

            </div>

            <!-- 底部進一步互動或聯絡區塊 -->
            <div class="bg-white/60 dark:bg-[#F5F3ED] border border-black/10 p-8 flex flex-col md:flex-row justify-between items-center gap-6">
                <div>
                    <h4 class="font-['Anton'] text-xl uppercase mb-1">Let's Connect & Build Together</h4>
                    <p class="text-xs text-neutral-600">正在尋找技術交流、專案合作或想了解更多細節？歡迎隨時聯繫。</p>
                </div>
                <div class="flex flex-wrap gap-3 font-['Roboto_Mono']">
                    {
                        mediaLink.map((item) => (
                            <a 
                                href={item.href} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="px-5 py-2.5 bg-[#6600FF] text-white text-xs font-bold uppercase tracking-wider hover:opacity-90 transition-opacity"
                            >
                                {item.label} <span><ArrowUpRight width={12} height={12} /></span>
                            </a>
                        ))
                    }
                    <a 
                        href="/" 
                        class="px-5 py-2.5 border border-black text-xs font-bold uppercase tracking-wider hover:bg-black hover:text-white transition-all duration-200"
                    >
                        Back to Home
                    </a>
                </div>
            </div>

        </div>
    </div>
</BaseLayout>

<style is:global>
    body {
        background-color: #DDF1FF;
        color: #09090B;
    }
</style>