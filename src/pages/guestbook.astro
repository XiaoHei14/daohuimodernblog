---
// src/pages/guestbook.astro
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Guestbook from "../components/Guestbook.astro";
import { SITE_TITLE } from "../consts";
import "@fontsource/anton";
import "@fontsource/roboto-mono";
import "@fontsource/cormorant-garamond";
---

<!doctype html>
<html lang="zh-Hant">
    <head>
        <BaseHead
            title={`Guestbook | ${SITE_TITLE}`}
            description="留下一句話吧。"
        />
    </head>
    <body
        class="bg-[#F5F3ED] text-neutral-900 dark:bg-[#0F172A] dark:text-neutral-100 antialiased selection:bg-[#6600FF] selection:text-white transition-colors duration-300"
    >
        <div class="px-4 sm:px-6 md:px-12 py-8 md:py-12">
            <Header />

            <main class="mx-auto mt-6 md:mt-8 w-full max-w-[1200px]">
                
                {/* 雜誌風頂部導覽列 */}
                <div
                    class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-black/20 dark:border-white/20 pb-4 font-['Roboto_Mono',monospace] text-xs tracking-wider"
                >
                    <div class="flex items-center gap-3">
                        <span class="inline-block rotate-[-2deg] bg-neutral-900 px-2 py-0.5 text-white dark:bg-white dark:text-neutral-900 font-bold">VOL. 04</span>
                        <span class="text-neutral-500 dark:text-neutral-400">EDITORIAL & SIGNATURES</span>
                    </div>
                    <span class="text-[#6600FF] font-bold">SAY HELLO →</span>
                </div>

                {/* 雜誌風大標題 Header */}
                <header class="pt-12 md:pt-24 relative">
                    
                    <div class="space-y-4">
                        <span class="inline-block font-['Roboto_Mono'] text-xs font-bold uppercase tracking-widest text-[#6600FF]">
                            [ 04. Open Registry ]
                        </span>
                        
                        <h1
                            class="font-['Anton',sans-serif] text-5xl sm:text-7xl lg:text-9xl uppercase leading-[0.95] tracking-tight text-neutral-900 dark:text-white break-words"
                        >
                            Guest<span class="text-[#6600FF]">book.</span>
                        </h1>
                    </div>

                    <div class="mt-6 flex items-center gap-4">
                        <div class="h-[2px] w-12 bg-[#6600FF] shrink-0"></div>
                        <p
                            class="font-['Cormorant_Garamond',serif] text-xl sm:text-2xl md:text-3xl italic text-neutral-600 dark:text-neutral-400"
                        >
                            Leave a permanent note in the margins of the archive.
                        </p>
                    </div>
                </header>

                {/* 雜誌邊框與留白容器 */}
                <div class="mt-12 md:mt-16 border-t border-black/10 dark:border-white/10 pt-8 md:pt-12">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
                        
                        {/* 左側欄：雜誌風格明細介紹 */}
                        <div class="lg:col-span-4 space-y-6 font-['Roboto_Mono'] text-xs text-neutral-600 dark:text-neutral-400">
                            <div class="p-5 sm:p-6 border border-black/10 dark:border-white/10 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-sm space-y-4">
                                <p class="font-bold text-neutral-900 dark:text-white uppercase tracking-wider">
                                    // Guidelines
                                </p>
                                <p class="leading-relaxed">
                                    此處為全站公開留言板。您可以透過 GitHub 快速驗證身份並留下您的印記，或以自訂名稱發表。請保持理性與友善。
                                </p>
                                <div class="pt-4 border-t border-black/10 dark:border-white/10 flex justify-between items-center text-[10px]">
                                    <span>ENCRYPTED V1.2</span>
                                    <span class="text-[#6600FF]">ACTIVE</span>
                                </div>
                            </div>
                        </div>

                        {/* 右側欄：Guestbook 元件主體 */}
                        <div class="lg:col-span-8 bg-white/30 dark:bg-neutral-900/30 border border-black/10 dark:border-white/10 p-4 sm:p-6 md:p-10 shadow-sm">
                            <Guestbook page="guestbook" showTitle={false} />
                        </div>

                    </div>
                </div>

            </main>
        </div>
        <Footer />
    </body>
</html>