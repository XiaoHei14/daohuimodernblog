---
import { getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { createSupabaseServerClient } from '../../lib/supabase-server';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const isSupabasePost = slug.startsWith('supabase-');

let remotePost: {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags: string[];
  contentHtml: string;
  content: string;
} | null = null;

let localPost: any = null;
let LocalContent: any = null;
let minutesRead = 1;

if (isSupabasePost) {
  const id = slug.slice('supabase-'.length);
  const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
  const { data, error } = await supabase
    .from('posts')
    .select('id, title, description, content, pub_date, hero_image, tags, published')
    .eq('id', id)
    .eq('published', true)
    .maybeSingle();

  if (error || !data) {
    return new Response('Not Found', { status: 404 });
  }

  const parsed = await marked.parse(data.content ?? '');
  const contentHtml = sanitizeHtml(parsed, {
    allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img', 'h1', 'h2', 'h3', 'pre', 'code', 'hr']),
    allowedAttributes: {
      ...sanitizeHtml.defaults.allowedAttributes,
      a: ['href', 'name', 'target', 'rel'],
      img: ['src', 'alt', 'title', 'width', 'height', 'loading'],
      code: ['class'],
      pre: ['class'],
    },
    transformTags: {
      a: sanitizeHtml.simpleTransform('a', { rel: 'noopener noreferrer', target: '_blank' }),
    },
  });

  remotePost = {
    title: data.title,
    description: data.description ?? '',
    pubDate: new Date(data.pub_date ?? new Date().toISOString()),
    heroImage: data.hero_image ?? undefined,
    tags: Array.isArray(data.tags) ? data.tags : [],
    contentHtml,
    content: data.content ?? '',
  };
  minutesRead = Math.max(1, Math.ceil(remotePost.content.split(/\s+/).filter(Boolean).length / 200));
} else {
  localPost = await getEntry('blog', slug);
  if (!localPost || localPost.data.draft) {
    return new Response('Not Found', { status: 404 });
  }
  const rendered = await render(localPost);
  LocalContent = rendered.Content;
  minutesRead = Number(rendered.remarkPluginFrontmatter.minutesRead ?? 1);
}
---
{isSupabasePost && remotePost ? (
  <BlogPost {...remotePost} minutesRead={minutesRead}>
    <Fragment set:html={remotePost.contentHtml} />
  </BlogPost>
) : localPost && LocalContent ? (
  <BlogPost {...localPost.data} minutesRead={minutesRead}>
    <LocalContent />
  </BlogPost>
) : (
  <main><h1>Not Found</h1></main>
)}
